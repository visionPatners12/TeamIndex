NODE_ENV=development
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?schema=team_index
TRADING_PROVIDER=polymarket
PROCESS_ROLE=all
PORT=3001
ADMIN_API_KEY=

# Polygon / Polymarket V2 / pUSD
POLYGON_RPC_URL=
POLYGON_EXECUTOR_PRIVATE_KEY=
POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com
POLYMARKET_CLOB_URL=https://clob.polymarket.com
POLYMARKET_DATA_API_URL=https://data-api.polymarket.com
POLYMARKET_RELAYER_URL=https://relayer-v2.polymarket.com
POLYMARKET_USER_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/user
POLYMARKET_PUSD_ADDRESS=0xC011a7E12a19f7B1f670d46F03B03f3342E82DFB
POLYMARKET_CTF_ADDRESS=0x4D97DCd97eC945f40cF65F87097ACe5EA0476045
POLYMARKET_CTF_EXCHANGE_ADDRESS=0xE111180000d2663C0091e4f400237545B87B996B
POLYMARKET_NEG_RISK_EXCHANGE_ADDRESS=0xe2222d279d744050d28e00520010520000310F59
POLYMARKET_DEPOSIT_WALLET_FACTORY=0x00000000000Fb5C9ADea0298D729A0CB3823Cc07
POLYMARKET_BUILDER_CODE=

# TeamIndex V2 contracts emitted by contracts:deploy:polygon:v2
TEAM_INDEX_V2_FACTORY_ADDRESS=
TEAM_INDEX_DEPOSIT_ESCROW_ADDRESS=

# Encrypted at rest CLOB credentials; 32-byte key encoded as 64 hex chars or base64.
POLYMARKET_CREDENTIALS_ENCRYPTION_KEY=

# Pilot risk/worker settings
POLYMARKET_MAX_ORDER_PUSD=25
POLYMARKET_PILOT_TVL_PUSD=1000
POLYMARKET_ACCOUNTING_INTERVAL_MS=60000
POLYMARKET_EXECUTOR_INTERVAL_MS=5000
POLYMARKET_RECONCILE_INTERVAL_MS=30000
POLYMARKET_EGRESS_CHECK_ENABLED=true

# Private signer service only. One named CDP EOA is created per pool.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
CDP_WALLET_SECRET=
POLYMARKET_SIGNER_URL=
POLYMARKET_SIGNER_TOKEN=

# Private signer service only. Hosted Polymarket relayer HMAC credentials.
POLY_BUILDER_API_KEY=
POLY_BUILDER_SECRET=
POLY_BUILDER_PASSPHRASE=

# Legacy variables are intentionally omitted. Legacy source remains in the repository,
# but TRADING_PROVIDER accepts only polymarket or the non-operational legacy-disabled mode.
